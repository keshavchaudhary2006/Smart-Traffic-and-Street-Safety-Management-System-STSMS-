{
  "name": "stsms",
  "version": "1.0.0",
  "description": "Smart Traffic and Street Safety Management System — Full-Stack + AI",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:ai": "cd ai-service && python main.py",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:ai": "cd ai-service && pip install -r requirements.txt",
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:ai",
    "benchmark:all": "python benchmarks/run_all_benchmarks.py",
    "benchmark:fps": "python benchmarks/benchmark_fps.py",
    "benchmark:traffic": "python benchmarks/benchmark_traffic_simulation.py",
    "benchmark:latency": "python benchmarks/benchmark_api_latency.py",
    "benchmark:prediction": "python benchmarks/benchmark_traffic_prediction.py"
  },
  "keywords": ["traffic", "safety", "yolo", "ai", "mern", "smart-city"],
  "author": "Keshav Chaudhary",
  "license": "MIT"
}
